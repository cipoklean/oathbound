# Copy to .env (never commit .env). No private keys here —
# use `cast wallet import` / `--account` for signing instead.
BSC_RPC_URL=https://bsc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
# BscScan API key for `forge script --verify` / `forge verify-contract`
BSCSCAN_API_KEY=
